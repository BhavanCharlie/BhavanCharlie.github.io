---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const jobEntries = (await getCollection('experience', (j) => !j.data.draft)).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
const jobs = await Promise.all(
  jobEntries.map(async (job) => ({ job, Content: (await render(job)).Content })),
);

const monthFormat = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const formatMonth = (ym: string) => monthFormat.format(new Date(`${ym}-01T00:00:00Z`));
const formatRange = (start: string, end?: string) =>
  `${formatMonth(start)} – ${end ? formatMonth(end) : 'Present'}`;

const year = new Date().getFullYear();
---

<Base>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="#top">{site.name}</a>
      <nav class="nav" aria-label="Main">
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
      {site.resume && <a class="button small" href={asset(site.resume)}>Résumé</a>}
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <p class="eyebrow">{site.title} · Co-founder at Rouhy</p>
            <h1 set:html={site.headline} />
            <p class="intro">{site.intro}</p>
            <div class="actions">
              <a class="button primary" href="#work">See my work</a>
              <a class="button" href={site.links.github} target="_blank" rel="noreferrer">GitHub</a>
              <a class="button" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            </div>
          </div>
          {site.photo && <img class="portrait" src={asset(site.photo)} alt={`Portrait of ${site.name}`} />}
        </div>

        <div class="stats">
          {site.stats.map((s) => (
            <div class="stat">
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Selected work</p>
          <h2>Systems I've designed and built.</h2>
        </div>
        <div class="projects">
          {projects.map(({ data }) => (
            <article class="project">
              {data.image && <img class="project-image" src={asset(data.image.replace(/^\//, ''))} alt="" loading="lazy" />}
              <div class="project-body">
                <div class="project-meta">
                  <span>{data.kicker}</span>
                  {data.status === 'in-progress' && <span class="badge">In progress</span>}
                </div>
                <h3>{data.title}</h3>
                <p>{data.summary}</p>
                {data.outcome && <p class="outcome">{data.outcome}</p>}
                <ul class="tags">
                  {data.tags.map((t) => <li>{t}</li>)}
                </ul>
                {(data.repo || data.demo) && (
                  <div class="project-links">
                    {data.demo && <a href={data.demo} target="_blank" rel="noreferrer">Live demo ↗</a>}
                    {data.repo && <a href={data.repo} target="_blank" rel="noreferrer">Source ↗</a>}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Experience</p>
          <h2>Where I've worked.</h2>
        </div>
        <ol class="jobs">
          {jobs.map(({ job: { data }, Content }) => (
            <li class="job">
              <div class="job-when">
                {formatRange(data.start, data.end)}
                {data.location && <><br />{data.location}</>}
              </div>
              <div>
                <h3>{data.role}</h3>
                <p class="job-company">
                  {data.companyUrl ? <a href={data.companyUrl} target="_blank" rel="noreferrer">{data.company}</a> : data.company}
                </p>
                <Content />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="about">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">About</p>
          <h2>Product-minded. Quality-obsessed.</h2>
        </div>
        <div class="about-grid">
          <div class="prose">
            {site.about.map((p) => <p>{p}</p>)}
            <ul class="principles">
              {site.principles.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <dl class="skills">
            {site.skills.map((s) => (
              <>
                <dt>{s.group}</dt>
                <dd>{s.items.join(' · ')}</dd>
              </>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap">
        <p class="eyebrow">Get in touch</p>
        <h2>Building something that needs to work every time?</h2>
        <div class="actions">
          {site.email && <a class="button primary" href={`mailto:${site.email}`}>Email me</a>}
          <a class={site.email ? 'button' : 'button primary'} href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="button" href={site.links.github} target="_blank" rel="noreferrer">GitHub</a>
          {site.resume && <a class="button" href={asset(site.resume)}>Résumé</a>}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© {year} {site.name}</span>
      <span>Built with Astro</span>
    </div>
  </footer>
</Base>
